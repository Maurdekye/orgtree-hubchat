{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hubchat",
  "version": "1.0.2",
  "identifier": "dev.orgtree.hubchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hubchat",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NjM5RDFDRTc3NjQ5QUEKUldTcVNYYm5ISjFqbVRlNVg2bC9uODR5Rkxlbi9zVTdGbWI3L2lBSWJYaDRRaWRDOFZadHlPMGIK",
      "endpoints": [
        "https://github.com/Maurdekye/orgtree-hubchat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
